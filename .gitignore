# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.pyc
*$py.class

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Flask stuff:
instance/
.webassets-cache

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# pyenv
.python-version

# dotenv and environment files
# Every .env* is ignored except the committed example templates. The broad
# .env.* rule matters: this is a public repository, and per-component files
# like .env.autoscaler must never be staged by a `git add .`.
.env
.env.*
!.env.example
!.env.example.*
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Secrets and keys (never commit these)
*.pem
*.key
secrets/

# Cloudflare tunnel config (contains tunnel ID)
# Keep config.example.yml, ignore actual config
deploy/cloudflared/config.yml
deploy/cloudflared/*.json

# Test artifacts
.pytest_cache/

# logs
*.log
logs/

# OS generated files (you have .DS_Store, but could add more)
.DS_Store
Thumbs.db
Desktop.ini

# development and debug scripts
development/
development_guide/
docs/internal/
docs/plans/
deploy/
