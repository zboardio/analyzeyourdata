# ================================
# SWARM AUTOSCALER
# ================================
# Template for .env.autoscaler on the deployment host.
#
#   cp .env.example.autoscaler .env.autoscaler
#
# .env* is gitignored (except the .env.example* templates), so host-specific
# tuning never reaches this public repository, and .dockerignore's .env.* rule
# keeps it out of the published image.
# docker-compose.cicd.yml references this file with `env_file:`, which means it
# MUST exist on the host or `docker stack deploy` fails -- the same requirement
# the application services already have for .env.
#
# Every setting below has a default compiled into ops/autoscaler/autoscaler.py,
# so the host file only needs the lines you actually want to change.
#
# Contains no credentials. It is a separate file from .env so the one container
# holding the Docker socket is not also handed the application's secrets.

# --- Rollout switch ---
# Log every decision without acting on it. Start here on a new node, read a few
# ticks of `docker service logs ayd_autoscaler`, then set to false.
AUTOSCALER_DRY_RUN=true

# --- Loop ---
# Seconds between ticks. Each tick samples CPU for every watched container.
AUTOSCALER_INTERVAL=60

# --- Capacity ceiling for this node ---
# Total replicas allowed across all watched services. Scale-ups stop once the
# stack reaches it; scale-downs are never blocked. Size it to the node: 15
# languages at max 3 would otherwise ask for 45 containers. 0 disables the cap.
# A 12-core / 32 GB single node comfortably runs 24.
AUTOSCALER_MAX_TOTAL_REPLICAS=24

# --- Defaults for services whose labels omit them ---
# Per-service bounds normally come from the ayd.autoscale.min/max labels in the
# compose file; these apply when a label is absent.
AUTOSCALER_MIN=1
AUTOSCALER_MAX=3

# --- Thresholds, as a percentage of each service's own CPU limit ---
# Busy enough to add a replica / idle enough to remove one.
AUTOSCALER_CPU_HIGH=75
AUTOSCALER_CPU_LOW=25

# --- Reaction speed ---
# Consecutive busy samples before scaling up, idle samples before scaling down.
# Up is deliberately quicker than down: help a busy service fast, shrink an idle
# one only once the lull is clearly real.
AUTOSCALER_UP_SAMPLES=2
AUTOSCALER_DOWN_SAMPLES=5

# Seconds after any change before another is considered.
AUTOSCALER_COOLDOWN=180

# --- Diagnostics ---
# DEBUG logs every sample; INFO logs one line per service per tick.
AUTOSCALER_LOG_LEVEL=INFO
