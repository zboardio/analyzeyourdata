# ================================
# APPLICATION SETTINGS
# ================================
APP_LANGUAGE=en

# ================================
# SERVER CONFIGURATION
# ================================
APP_HOST=0.0.0.0
APP_PORT=8050
APP_DEBUG=False

# ================================
# FILE UPLOAD SETTINGS
# ================================
MAX_FILE_SIZE_MB=20
# Hard cap on any HTTP request body (MB). Needs headroom above MAX_FILE_SIZE_MB:
# uploads travel base64-encoded and grid/chart callbacks POST the dataset back.
# 0 = auto (5 x MAX_FILE_SIZE_MB)
MAX_CONTENT_LENGTH_MB=0
# Row cap for external sources (Google Sheets, Airtable). 0 = unlimited.
# Set on shared/public hosting to protect the instance from oversized sheets.
MAX_EXTERNAL_ROWS=0
SUPPORTED_FILE_FORMATS=csv,xlsx,xls,json,parquet,h5,hdf5,h6,plh,txt,log,db,sqlite,sqlite3

# ================================
# CONTENT DIRECTORIES
# ================================
MARKDOWN_DIRECTORY=assets/markdown
ASSETS_DIRECTORY=assets

# ================================
# UI ASSETS
# ================================
# Logo in navbar (leave empty to hide logo, brand text remains)
LOGO_PATH=/assets/logo.png
# Favicon: assets/favicon.svg + assets/favicon.ico fallback — baked in, no config needed

# ================================
# EXTERNAL LINKS
# ================================
# Source repository shown in the footer ("Verify source code" / build link).
# Keep pointing at the upstream repo unless you deploy a modified fork.
GITHUB_URL=https://github.com/zboardio/analyzeyourdata
WEBSITE_URL=https://example.com/en/
CONTACT_EMAIL=contact@example.com
# Documentation URL (leave empty to hide docs buttons in footer and modal)
DOCUMENTATION_URL=

# Donation / Support link (Stripe, Buy Me a Coffee, etc.)
# Leave empty to hide the donation card
DONATE_URL=

# YouTube intro video (embed URL, not watch URL)
# Use format: https://www.youtube.com/embed/VIDEO_ID
# Leave empty to hide the video section
YOUTUBE_INTRO_URL=

# ================================
# COMPANY / BRANDING
# ================================
COMPANY_NAME=Your Company Name
# Short name for "Powered by" tile (COMPANY_NAME is used in footer)
POWERED_BY_AUTHOR_NAME=Your Name

# ================================
# AG GRID CONFIGURATION
# ================================
# AG Grid Enterprise license key (optional).
# Without a key the app runs AG Grid Community (MIT licensed, free for any use):
# sorting, filtering, CSV export — no watermark.
# With a key, Enterprise features are enabled automatically: row grouping,
# pivoting, sidebar tool panels, Excel export.
AG_GRID_LICENSE_KEY=
# Enterprise modules switch: auto | true | false
#   auto  (default) — Enterprise only when AG_GRID_LICENSE_KEY is set
#   true            — force Enterprise WITHOUT a key: AG Grid runs in unlicensed
#                     evaluation mode (watermark + console errors). AG Grid permits
#                     this for evaluation/development only — production use of
#                     Enterprise requires a purchased license (there is no free
#                     non-commercial Enterprise tier). Your responsibility.
#   false           — force Community mode even if a key is set
AG_GRID_ENABLE_ENTERPRISE=auto
AG_GRID_THEME=ag-theme-alpine
AG_GRID_HEIGHT=700

# ================================
# CHART SETTINGS
# ================================
DEFAULT_CHART_TYPE=scatter
CHART_HEIGHT=700
CHART_COLOR_SCHEME=plotly

# ================================
# LANGUAGE SETTINGS
# ================================
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,cs,da,de,es,fr,hr,it,nl,pl,pt,sk,sl,sv,uk

# Language instance URLs (for navbar cross-links)
# Local development defaults:
APP_URL_EN=http://localhost:8050
APP_URL_CS=http://localhost:8051
APP_URL_DE=http://localhost:8052
APP_URL_PL=http://localhost:8053
APP_URL_DA=http://localhost:8054
APP_URL_ES=http://localhost:8055
APP_URL_FR=http://localhost:8056
APP_URL_HR=http://localhost:8057
APP_URL_IT=http://localhost:8058
APP_URL_NL=http://localhost:8059
APP_URL_PT=http://localhost:8060
APP_URL_SK=http://localhost:8061
APP_URL_SL=http://localhost:8062
APP_URL_SV=http://localhost:8063
APP_URL_UK=http://localhost:8064

# Production example (Cloudflare Tunnel subdomains):
# APP_URL_EN=https://en.example.com
# APP_URL_CS=https://cs.example.com
# APP_URL_DA=https://da.example.com
# APP_URL_DE=https://de.example.com
# APP_URL_ES=https://es.example.com
# APP_URL_FR=https://fr.example.com
# APP_URL_HR=https://hr.example.com
# APP_URL_IT=https://it.example.com
# APP_URL_NL=https://nl.example.com
# APP_URL_PL=https://pl.example.com
# APP_URL_PT=https://pt.example.com
# APP_URL_SK=https://sk.example.com
# APP_URL_SL=https://sl.example.com
# APP_URL_SV=https://sv.example.com
# APP_URL_UK=https://uk.example.com

# ================================
# DATABASE SETTINGS (MongoDB)
# ================================
MONGO_URI=mongodb+srv://user:password@cluster.example.net/
MONGODB_DATABASE=analyzeYourData
MONGODB_COLLECTION_LOGS=usageLogs
MONGODB_COLLECTION_FEEDBACK=feedback

# ================================
# PERFORMANCE MONITORING
# ================================
# Prints RSS memory usage to stdout every interval (debugging aid)
MEMORY_MONITORING_ENABLED=False
MEMORY_MONITORING_INTERVAL=3

# ================================
# SECURITY
# ================================
# Flask session signing key
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
